# Reverse API Engineer - Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME="Reverse API Engineer"
APP_VERSION="0.1.0"
ENVIRONMENT=development
DEBUG=true
API_PREFIX="/api/v1"

# Server
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/reverse_api_engineer
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Supabase (for auth, storage, realtime)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Redis (for caching, Celery)
REDIS_URL=redis://localhost:6379/0

# Celery (background tasks)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Security
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# CLI Execution
CLI_EXECUTABLE_PATH=reverse-api-engineer
CLI_WORKING_DIR=/tmp/reverse-api-engineer
CLI_TIMEOUT_SECONDS=3600
MAX_CONCURRENT_JOBS=3

# Browser/Playwright
PLAYWRIGHT_BROWSERS_PATH=0
BROWSER_PROVIDER=playwright

# AI Providers (optional)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Storage
ARTIFACT_STORAGE_PATH=/app/storage
MAX_UPLOAD_SIZE_MB=100
MAX_PROJECT_STORAGE_GB=10

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json